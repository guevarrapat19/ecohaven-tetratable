{
  "rules": {
    "ecohaven": {
      ".read": true,
      ".write": true,
      "products": {
        ".read": true,
        ".write": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'admin' || root.child('users/' + auth.uid + '/role').val() === 'seller' || !data.exists())"
      },
      "inventory": {
        ".read": true,
        ".write": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'admin' || root.child('users/' + auth.uid + '/role').val() === 'seller' || !data.exists())"
      },
      "orders": {
        ".read": true,
        ".write": true,
        "$orderId": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['customerName']) && newData.child('items').exists() && (newData.child('totalAmount').val() > 0 || newData.child('pricing/totalAmount').val() > 0) || !newData.exists()"
        }
      },
      "notifications": {
        ".read": true,
        ".write": true
      },
      "telemetry": {
        ".read": true,
        ".write": true
      },
      "logisticsZones": {
        ".read": true,
        ".write": "auth != null && (root.child('users/' + auth.uid + '/role').val() === 'admin' || !data.exists())"
      }
    },
    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null ? (auth.uid === $uid || root.child('users/' + auth.uid + '/role').val() === 'admin' || root.child('users/' + auth.uid + '/role').val() === 'seller') : true",
        ".validate": "newData.hasChildren(['email']) && (newData.child('displayName').exists() || newData.child('fullName').exists()) || !newData.exists()"
      }
    }
  }
}
